# Cloudflare R2 雲端儲存資料庫設定
# 1. 登入 Cloudflare 儀表板 -> 點擊側邊欄「R2」
# 2. 建立一個 Bucket (儲存貯體)，名稱例如：yougu-orders
# 3. 點擊右側「Manage R2 API Tokens」->「Create API Token」取得 Access Key ID 與 Secret Access Key
# 4. 在 Cloudflare 儀表板 Overview 取得 Account ID

CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=yougu-orders

# 可選自訂 Endpoint (若未填寫會自動依 CLOUDFLARE_ACCOUNT_ID 組合)
# R2_ENDPOINT=https://<your_account_id>.r2.cloudflarestorage.com

# ----------------------------------------------------
# LINE 官方新訂單即時推播通知 (可選)
# 當顧客下單時，系統自動發送 LINE 訊息通知店長個人 LINE 或店長工作群組
# 申請處：LINE Developers Console (https://developers.line.biz/)
# 1. 取得 Messaging API 的 Channel Access Token (長期)
# 2. 取得店長的 LINE User ID 或群組 Group ID
# ----------------------------------------------------
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token
LINE_STORE_USER_ID=your_line_user_id_or_group_id

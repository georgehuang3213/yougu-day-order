# Cloudflare R2 雲端儲存資料庫設定
# 1. 登入 Cloudflare 儀表板 -> 點擊側邊欄「R2」
# 2. 建立一個 Bucket (儲存貯體)，名稱例如：yougu-orders
# 3. 點擊右側「Manage R2 API Tokens」->「Create API Token」取得 Access Key ID 與 Secret Access Key
# 4. 在 Cloudflare 儀表板 Overview 取得 Account ID

CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=yougu-orders

# 可選自訂 Endpoint (若未填寫會自動依 CLOUDFLARE_ACCOUNT_ID 組合)
# R2_ENDPOINT=https://<your_account_id>.r2.cloudflarestorage.com

# ----------------------------------------------------
# Telegram 新訂單即時推播通知 (可選)
# 當顧客下單時，系統自動發送 Telegram 訊息通知店長
# 設定方式：
# 1. 在 Telegram 搜尋 @BotFather，建立 Bot 並取得 Token
# 2. 將 Bot 加入群組，取得群組 Chat ID（可透過 @getidsbot 取得）
# 3. 支援多個 Chat ID 以逗號分隔
# ----------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
